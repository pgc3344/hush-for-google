{
  "manifest_version": 3,
  "name": "Hush for Google",
  "short_name": "Hush",
  "version": "1.0.4",
  "description": "Google, without the upsell. Hides Upgrade / Google One / AI Pro buttons across Google services.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.google.com/*", "*://gemini.google.com/*", "*://*.youtube.com/*"],
      "js": ["rules.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
